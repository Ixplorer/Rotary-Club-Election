# =============================================================================
# ROTARY CLUB OF ASOKORO — 2027/2028 OFFICERS ELECTION PORTAL
# Environment Configuration (.env)
# =============================================================================

# Database Driver:
# - 'auto'   : Tries MySQL first. If MySQL is not configured or offline, falls back to SQLite.
# - 'mysql'  : Enforces MySQL/MariaDB (Standard for live cPanel/Plesk/VPS hosting).
# - 'sqlite' : Enforces standalone file-based SQLite database (data/election.db).
DB_DRIVER=auto

# MySQL / MariaDB Credentials (Required only if using MySQL on live server)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rotary_election
DB_USER=root
DB_PASS=

# Electoral Committee Admin Portal Passkey
ADMIN_PASSKEY=asokoro2027
